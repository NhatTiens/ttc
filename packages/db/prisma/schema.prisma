generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SUPPORT
  FINANCE
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SocialPlatform {
  FACEBOOK
  TIKTOK
  INSTAGRAM
  YOUTUBE
  THREADS
  GOOGLE
}

enum ServiceStatus {
  ACTIVE
  MAINTENANCE
  DISABLED
}

enum OrderStatus {
  PENDING
  VALIDATING
  SUBMITTED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  REFUNDED
}

enum WalletTransactionType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum DepositMethodType {
  BANK
  QR
  MANUAL
}

enum DepositStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum SupportTicketStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_SUPPORT
  RESOLVED
  CLOSED
}

enum SupportSenderType {
  CUSTOMER
  ADMIN
}


enum ProviderStatus {
  ACTIVE
  DISABLED
  DEGRADED
}

enum ProviderHealth {
  HEALTHY
  DEGRADED
  DOWN
  UNKNOWN
}

enum ProviderServiceStatus {
  AVAILABLE
  UNAVAILABLE
  DISABLED
  REMOVED
}

enum ProviderMappingStatus {
  ACTIVE
  DISABLED
  PRICE_REVIEW_REQUIRED
  PROVIDER_UNAVAILABLE
  MIN_MAX_CONFLICT
}

enum ProviderMarkupType {
  PERCENTAGE
  FIXED
}

enum ProviderPricingMode {
  MANUAL
  AUTO_MARKUP
}

enum ProviderSubmissionState {
  PENDING
  PREPARED
  SENDING
  SAFE_TO_RETRY
  UNKNOWN_SUBMISSION
  ACCEPTED
  REJECTED
  MANUAL_REVIEW
}

enum ProviderOrderStatus {
  CREATED
  SUBMITTED
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
  REFUNDED
  UNKNOWN
}

enum ProviderJobType {
  SUBMIT_ORDER
  POLL_ORDER_STATUS
  SYNC_SERVICES
  SYNC_BALANCE
  TEST_CONNECTION
}

enum ProviderJobStatus {
  PENDING
  RUNNING
  RETRY
  MANUAL_REVIEW
  COMPLETED
  FAILED
}

model User {
  id                       String                 @id @default(uuid()) @db.Uuid
  email                    String                 @unique @db.VarChar(320)
  passwordHash             String                 @map("password_hash") @db.Text
  name                     String                 @db.VarChar(120)
  phone                    String?                @db.VarChar(32)
  role                     UserRole               @default(CUSTOMER)
  status                   UserStatus             @default(ACTIVE)
  emailVerifiedAt          DateTime?              @map("email_verified_at") @db.Timestamptz(3)
  twoFactorEnabled         Boolean                @default(false) @map("two_factor_enabled")
  lastPasswordChangeAt     DateTime               @default(now()) @map("last_password_change_at") @db.Timestamptz(3)
  sessionVersion           Int                    @default(1) @map("session_version")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts                 Account[]
  sessions                 Session[]
  wallet                   Wallet?
  notificationPreference   NotificationPreference?
  orders                   Order[]
  deposits                 Deposit[]
  supportTickets           SupportTicket[]
  supportMessages          SupportMessage[]       @relation("SupportMessageSender")
  adminWalletTransactions  WalletTransaction[]    @relation("WalletTransactionAdmin")
  adminAuditLogs            AdminAuditLog[]         @relation("AdminAuditActor")
  servicePriceChanges       ServicePriceHistory[]   @relation("ServicePriceHistoryAdmin")
  systemSettingsUpdated     SystemSetting[]         @relation("SystemSettingUpdater")
  providerAuditMappings     ServiceProviderMapping[] @relation("ProviderMappingAdmin")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @db.VarChar(64)
  provider          String  @db.VarChar(128)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type") @db.VarChar(64)
  scope             String? @db.Text
  idToken           String? @map("id_token") @db.Text
  sessionState      String? @map("session_state") @db.VarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token") @db.VarChar(255)
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(320)
  token      String   @unique @db.VarChar(255)
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @db.VarChar(320)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, expiresAt])
  @@map("password_reset_tokens")
}

model Wallet {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @unique @map("user_id") @db.Uuid
  balanceMinor  BigInt              @default(0) @map("balance_minor")
  reservedMinor BigInt              @default(0) @map("reserved_minor")
  currency      String              @default("VND") @db.Char(3)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                 String                  @id @default(uuid()) @db.Uuid
  walletId           String                  @map("wallet_id") @db.Uuid
  type               WalletTransactionType
  status             WalletTransactionStatus
  amountMinor        BigInt                  @map("amount_minor")
  balanceBeforeMinor BigInt                  @map("balance_before_minor")
  balanceAfterMinor  BigInt                  @map("balance_after_minor")
  referenceType      String?                 @map("reference_type") @db.VarChar(64)
  referenceId        String?                 @map("reference_id") @db.VarChar(128)
  description        String                  @db.VarChar(255)
  idempotencyKey     String?                 @map("idempotency_key") @db.VarChar(128)
  adminUserId        String?                 @map("admin_user_id") @db.Uuid
  reason             String?                 @db.VarChar(255)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet             Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  adminUser          User?                   @relation("WalletTransactionAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([adminUserId, createdAt(sort: Desc)])
  @@map("wallet_transactions")
}

model ServiceCategory {
  id        String    @id @db.VarChar(64)
  name      String    @db.VarChar(120)
  sortOrder Int       @default(0) @map("sort_order")
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  services  Service[]

  @@map("service_categories")
}

model Service {
  id                   String          @id @db.VarChar(64)
  code                 String          @unique @db.VarChar(64)
  name                 String          @db.VarChar(180)
  description          String          @db.Text
  platform             SocialPlatform
  categoryId           String          @map("category_id") @db.VarChar(64)
  ratePerThousandMinor BigInt          @map("rate_per_thousand_minor")
  min                  Int
  max                  Int
  averageTime          String          @map("average_time") @db.VarChar(80)
  status               ServiceStatus   @default(ACTIVE)
  popular              Boolean         @default(false)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  category             ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orders               Order[]
  priceHistory         ServicePriceHistory[]
  providerMappings     ServiceProviderMapping[]

  @@index([platform, status])
  @@index([categoryId, status])
  @@map("services")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  publicId       String      @unique @map("public_id") @db.VarChar(32)
  userId         String      @map("user_id") @db.Uuid
  serviceId      String      @map("service_id") @db.VarChar(64)
  targetUrl      String      @map("target_url") @db.Text
  quantity       Int
  chargeMinor    BigInt      @map("charge_minor")
  refundedMinor  BigInt      @default(0) @map("refunded_minor")
  startCount     Int?        @map("start_count")
  remaining      Int
  status         OrderStatus @default(PENDING)
  idempotencyKey String      @map("idempotency_key") @db.VarChar(128)
  requestFingerprint String  @map("request_fingerprint") @db.VarChar(64)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  service        Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  logs           OrderLog[]
  providerOrder  ProviderOrder?
  providerJobs   ProviderJob[]
  providerAttempts ProviderOrderAttempt[]
  providerOperationLogs ProviderOperationLog[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([serviceId, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderLog {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  message    String       @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_logs")
}

model DepositMethod {
  id           String            @id @db.VarChar(64)
  name         String            @db.VarChar(120)
  type         DepositMethodType
  description  String            @db.Text
  minMinor     BigInt            @map("min_minor")
  maxMinor     BigInt            @map("max_minor")
  feeLabel     String            @map("fee_label") @db.VarChar(120)
  enabled      Boolean           @default(true)
  instructions Json
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  deposits     Deposit[]

  @@map("deposit_methods")
}

model Deposit {
  id             String        @id @default(uuid()) @db.Uuid
  publicId       String        @unique @map("public_id") @db.VarChar(32)
  userId         String        @map("user_id") @db.Uuid
  methodId       String        @map("method_id") @db.VarChar(64)
  amountMinor    BigInt        @map("amount_minor")
  status         DepositStatus @default(PENDING)
  reference      String?       @db.VarChar(128)
  idempotencyKey String        @map("idempotency_key") @db.VarChar(128)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  method         DepositMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("deposits")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  depositId         String        @map("deposit_id") @db.Uuid
  gateway           String        @db.VarChar(64)
  externalPaymentId String?       @map("external_payment_id") @db.VarChar(255)
  amountMinor       BigInt        @map("amount_minor")
  currency          String        @default("VND") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(128)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  deposit           Deposit       @relation(fields: [depositId], references: [id], onDelete: Restrict)
  events            PaymentEvent[]

  @@unique([gateway, externalPaymentId])
  @@index([depositId, createdAt(sort: Desc)])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  paymentId       String?  @map("payment_id") @db.Uuid
  gateway         String   @db.VarChar(64)
  externalEventId String   @map("external_event_id") @db.VarChar(255)
  payloadHash     String   @map("payload_hash") @db.VarChar(128)
  payload         Json?
  signatureValid  Boolean  @default(false) @map("signature_valid")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  errorCode       String?  @map("error_code") @db.VarChar(80)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([gateway, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

model SupportTicket {
  id        String              @id @default(uuid()) @db.Uuid
  publicId  String              @unique @map("public_id") @db.VarChar(32)
  userId    String              @map("user_id") @db.Uuid
  subject   String              @db.VarChar(180)
  category  String              @db.VarChar(80)
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  SupportMessage[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([status, updatedAt(sort: Desc)])
  @@map("support_tickets")
}

model SupportMessage {
  id           String            @id @default(uuid()) @db.Uuid
  ticketId     String            @map("ticket_id") @db.Uuid
  senderType   SupportSenderType @map("sender_type")
  senderUserId String?           @map("sender_user_id") @db.Uuid
  body         String            @db.Text
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket       SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser   User?             @relation("SupportMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([senderUserId])
  @@map("support_messages")
}

model NotificationPreference {
  userId         String   @id @map("user_id") @db.Uuid
  orderUpdates   Boolean  @default(true) @map("order_updates")
  walletUpdates  Boolean  @default(true) @map("wallet_updates")
  promotions     Boolean  @default(false)
  supportReplies Boolean  @default(true) @map("support_replies")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}


model ServicePriceHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  serviceId            String   @map("service_id") @db.VarChar(64)
  previousRateMinor    BigInt   @map("previous_rate_minor")
  newRateMinor         BigInt   @map("new_rate_minor")
  adminUserId          String   @map("admin_user_id") @db.Uuid
  reason               String?  @db.VarChar(255)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  service              Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  adminUser            User     @relation("ServicePriceHistoryAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([serviceId, createdAt(sort: Desc)])
  @@index([adminUserId, createdAt(sort: Desc)])
  @@map("service_price_history")
}

model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  action      String   @db.VarChar(80)
  entityType  String   @map("entity_type") @db.VarChar(80)
  entityId    String   @map("entity_id") @db.VarChar(128)
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  adminUser   User     @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc)])
  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model SystemSetting {
  id                    String   @id @default("default") @db.VarChar(32)
  siteName              String   @default("Tương Tác Pro") @map("site_name") @db.VarChar(120)
  supportEmail          String   @default("support@example.com") @map("support_email") @db.VarChar(320)
  maintenanceMode       Boolean  @default(false) @map("maintenance_mode")
  minimumDepositMinor   BigInt   @default(50000) @map("minimum_deposit_minor")
  orderCreationEnabled  Boolean  @default(true) @map("order_creation_enabled")
  supportEnabled        Boolean  @default(true) @map("support_enabled")
  updatedByUserId       String?  @map("updated_by_user_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUser         User?    @relation("SystemSettingUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model Provider {
  id                String          @id @default(uuid()) @db.Uuid
  code              String          @unique @db.VarChar(32)
  name              String          @db.VarChar(120)
  status            ProviderStatus  @default(DISABLED)
  health            ProviderHealth  @default(UNKNOWN)
  baseUrl           String?         @map("base_url") @db.VarChar(500)
  enabled           Boolean         @default(false)
  priority          Int             @default(100)
  timeoutMs             Int             @default(10000) @map("timeout_ms")
  maxConcurrentRequests Int             @default(1) @map("max_concurrent_requests")
  minRequestIntervalMs  Int             @default(250) @map("min_request_interval_ms")
  nextRequestAt         DateTime?       @map("next_request_at") @db.Timestamptz(3)
  balanceMinor      BigInt?         @map("balance_minor")
  balanceCurrency   String?         @map("balance_currency") @db.VarChar(16)
  lastBalanceSyncAt DateTime?       @map("last_balance_sync_at") @db.Timestamptz(3)
  lastHealthAt      DateTime?       @map("last_health_at") @db.Timestamptz(3)
  lastSuccessfulAt  DateTime?       @map("last_successful_at") @db.Timestamptz(3)
  lastErrorCode     String?         @map("last_error_code") @db.VarChar(80)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  services          ProviderService[]
  providerOrders    ProviderOrder[]
  attempts          ProviderOrderAttempt[]
  jobs              ProviderJob[]
  operationLogs     ProviderOperationLog[]
  balanceSnapshots  ProviderBalanceSnapshot[]
  requestLeases     ProviderRequestLease[]

  @@index([enabled, status, priority])
  @@map("providers")
}

model ProviderService {
  id                    String                @id @default(uuid()) @db.Uuid
  providerId            String                @map("provider_id") @db.Uuid
  externalServiceId     String                @map("external_service_id") @db.VarChar(255)
  name                  String                @db.VarChar(255)
  category              String?               @db.VarChar(120)
  platform              SocialPlatform?
  providerRateMinor     BigInt                @map("provider_rate_minor")
  rateUnit              Int                   @default(1000) @map("rate_unit")
  currency              String                @default("VND") @db.VarChar(16)
  min                   Int
  max                   Int
  supportsRefill        Boolean               @default(false) @map("supports_refill")
  supportsCancel        Boolean               @default(false) @map("supports_cancel")
  status                ProviderServiceStatus @default(AVAILABLE)
  rawMetadata           Json?                 @map("raw_metadata")
  lastSyncedAt          DateTime              @map("last_synced_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  provider              Provider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  mappings              ServiceProviderMapping[]
  priceHistory          ProviderPriceHistory[]
  providerOrders        ProviderOrder[]
  attempts              ProviderOrderAttempt[]

  @@unique([providerId, externalServiceId])
  @@index([providerId, status, lastSyncedAt(sort: Desc)])
  @@index([platform, status])
  @@map("provider_services")
}

model ServiceProviderMapping {
  id                  String                @id @default(uuid()) @db.Uuid
  serviceId           String                @map("service_id") @db.VarChar(64)
  providerServiceId   String                @map("provider_service_id") @db.Uuid
  enabled             Boolean               @default(true)
  priority            Int                   @default(100)
  autoFallbackAllowed Boolean               @default(false) @map("auto_fallback_allowed")
  markupType          ProviderMarkupType    @default(PERCENTAGE) @map("markup_type")
  markupBps           Int                   @default(0) @map("markup_bps")
  fixedMarkupMinor    BigInt                @default(0) @map("fixed_markup_minor")
  minimumMarginMinor  BigInt                @default(0) @map("minimum_margin_minor")
  pricingMode         ProviderPricingMode   @default(MANUAL) @map("pricing_mode")
  status              ProviderMappingStatus @default(ACTIVE)
  lastPriceReviewAt   DateTime?             @map("last_price_review_at") @db.Timestamptz(3)
  updatedByUserId     String?               @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  service             Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  providerService     ProviderService       @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  updatedByUser       User?                 @relation("ProviderMappingAdmin", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([serviceId, providerServiceId])
  @@unique([serviceId, priority])
  @@index([providerServiceId, enabled, status])
  @@map("service_provider_mappings")
}

model ProviderPriceHistory {
  id                  String          @id @default(uuid()) @db.Uuid
  providerServiceId   String          @map("provider_service_id") @db.Uuid
  previousRateMinor   BigInt          @map("previous_rate_minor")
  newRateMinor        BigInt          @map("new_rate_minor")
  source              String          @db.VarChar(64)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  providerService     ProviderService @relation(fields: [providerServiceId], references: [id], onDelete: Cascade)

  @@index([providerServiceId, createdAt(sort: Desc)])
  @@map("provider_price_history")
}

model ProviderOrder {
  id                         String                  @id @default(uuid()) @db.Uuid
  orderId                    String                  @unique @map("order_id") @db.Uuid
  providerId                 String                  @map("provider_id") @db.Uuid
  providerServiceId          String                  @map("provider_service_id") @db.Uuid
  externalOrderId            String?                 @map("external_order_id") @db.VarChar(255)
  clientReference            String                  @unique @map("client_reference") @db.VarChar(128)
  submissionState            ProviderSubmissionState @default(PENDING) @map("submission_state")
  status                     ProviderOrderStatus     @default(CREATED)
  attemptCount               Int                     @default(0) @map("attempt_count")
  providerRateSnapshotMinor  BigInt                  @map("provider_rate_snapshot_minor")
  rateUnitSnapshot           Int                     @map("rate_unit_snapshot")
  providerCostMinor          BigInt                  @map("provider_cost_minor")
  customerChargeMinor        BigInt                  @map("customer_charge_minor")
  grossMarginMinor           BigInt                  @map("gross_margin_minor")
  currency                   String                  @default("VND") @db.VarChar(16)
  requestPayload             Json?                   @map("request_payload")
  responsePayload            Json?                   @map("response_payload")
  submittedAt                DateTime?               @map("submitted_at") @db.Timestamptz(3)
  lastCheckedAt              DateTime?               @map("last_checked_at") @db.Timestamptz(3)
  nextPollAt                 DateTime?               @map("next_poll_at") @db.Timestamptz(3)
  lastErrorCode              String?                 @map("last_error_code") @db.VarChar(80)
  lastErrorMessage           String?                 @map("last_error_message") @db.VarChar(500)
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  order                      Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider                   Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService            ProviderService         @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)
  attempts                   ProviderOrderAttempt[]
  jobs                       ProviderJob[]

  @@unique([providerId, externalOrderId])
  @@index([providerId, status, updatedAt])
  @@index([submissionState, updatedAt])
  @@index([nextPollAt, status])
  @@map("provider_orders")
}

model ProviderOrderAttempt {
  id                      String                  @id @default(uuid()) @db.Uuid
  orderId                 String                  @map("order_id") @db.Uuid
  providerOrderRecordId   String?                 @map("provider_order_record_id") @db.Uuid
  providerId              String                  @map("provider_id") @db.Uuid
  providerServiceId       String                  @map("provider_service_id") @db.Uuid
  action                  String                  @default("CREATE") @db.VarChar(32)
  attemptNo               Int                     @map("attempt_no")
  providerIdempotencyKey  String?                 @map("provider_idempotency_key") @db.VarChar(128)
  clientReference         String?                 @map("client_reference") @db.VarChar(128)
  requestHash             String                  @map("request_hash") @db.VarChar(64)
  state                   ProviderSubmissionState @default(PREPARED)
  httpStatus              Int?                    @map("http_status")
  externalOrderId         String?                 @map("external_order_id") @db.VarChar(255)
  errorCode               String?                 @map("error_code") @db.VarChar(80)
  startedAt               DateTime                @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt              DateTime?               @map("finished_at") @db.Timestamptz(3)
  order                   Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerOrder           ProviderOrder?          @relation(fields: [providerOrderRecordId], references: [id], onDelete: SetNull)
  provider                Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerService         ProviderService         @relation(fields: [providerServiceId], references: [id], onDelete: Restrict)

  @@unique([orderId, action, attemptNo])
  @@index([providerId, providerIdempotencyKey])
  @@index([orderId, startedAt(sort: Desc)])
  @@index([state, startedAt])
  @@map("provider_order_attempts")
}

model ProviderJob {
  id                String            @id @default(uuid()) @db.Uuid
  type              ProviderJobType
  status            ProviderJobStatus @default(PENDING)
  dedupeKey         String            @unique @map("dedupe_key") @db.VarChar(180)
  providerId        String?           @map("provider_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  providerOrderId   String?           @map("provider_order_id") @db.Uuid
  payload           Json?
  runAt             DateTime          @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts          Int               @default(0)
  maxAttempts       Int               @default(6) @map("max_attempts")
  lockedAt          DateTime?         @map("locked_at") @db.Timestamptz(3)
  lockedBy          String?           @map("locked_by") @db.VarChar(120)
  lastErrorCode     String?           @map("last_error_code") @db.VarChar(80)
  lastErrorMessage  String?           @map("last_error_message") @db.VarChar(500)
  completedAt       DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  provider          Provider?         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order             Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  providerOrder     ProviderOrder?    @relation(fields: [providerOrderId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([providerId, status, runAt])
  @@index([orderId, createdAt(sort: Desc)])
  @@map("provider_jobs")
}

model ProviderOperationLog {
  id                String    @id @default(uuid()) @db.Uuid
  providerId        String    @map("provider_id") @db.Uuid
  orderId           String?   @map("order_id") @db.Uuid
  operation         String    @db.VarChar(64)
  externalOrderId   String?   @map("external_order_id") @db.VarChar(255)
  durationMs        Int?      @map("duration_ms")
  result            String    @db.VarChar(48)
  attempt           Int       @default(1)
  errorCode         String?   @map("error_code") @db.VarChar(80)
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  provider          Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  order             Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([providerId, createdAt(sort: Desc)])
  @@index([orderId, createdAt(sort: Desc)])
  @@index([result, createdAt(sort: Desc)])
  @@map("provider_operation_logs")
}

model ProviderBalanceSnapshot {
  id            String    @id @default(uuid()) @db.Uuid
  providerId    String    @map("provider_id") @db.Uuid
  amountMinor   BigInt    @map("amount_minor")
  currency      String    @db.VarChar(16)
  capturedAt    DateTime  @default(now()) @map("captured_at") @db.Timestamptz(3)
  provider      Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, capturedAt(sort: Desc)])
  @@map("provider_balance_snapshots")
}

model ProviderRequestLease {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  workerId    String   @map("worker_id") @db.VarChar(120)
  acquiredAt  DateTime @default(now()) @map("acquired_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  provider    Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, expiresAt])
  @@map("provider_request_leases")
}
