# Work 04 — local development only. Copy to .env and replace all secrets.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuong_tac_pro?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tuong_tac_pro_test?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-at-least-32-random-bytes"
AUTH_TRUST_HOST="true"
# Optional when running behind a non-standard host/proxy.
# AUTH_URL="http://localhost:3000"

# Idempotent development seed account. Never use these values in production.
SEED_DEVELOPMENT_ACCOUNT="true"
SEED_DEVELOPMENT_EMAIL="minh@example.com"
SEED_DEVELOPMENT_PASSWORD="demo1234"

# Work 05 — development-only admin/secondary customer seed accounts.
# Never reuse these passwords in production. Override them in local .env if desired.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin1234"
SEED_DEVELOPMENT_SECOND_EMAIL="lan@example.com"
SEED_DEVELOPMENT_SECOND_PASSWORD="demo1234"

# Optional admin runtime smoke target.
# WORK5_BASE_URL="http://localhost:3000"
